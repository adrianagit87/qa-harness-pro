{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 {{HARNESS}}/adapters/cursor/hooks/block-destructive-command.py",
        "timeout": 15
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python3 {{HARNESS}}/adapters/cursor/hooks/validate-external-write.py",
        "timeout": 15
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 {{HARNESS}}/adapters/cursor/hooks/check-after-edit.py",
        "timeout": 120
      }
    ]
  }
}
