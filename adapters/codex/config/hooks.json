{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{HARNESS}}/adapters/codex/hooks/block-destructive-command.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{HARNESS}}/adapters/codex/hooks/validate-external-write.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{HARNESS}}/adapters/codex/hooks/snapshot-before-shell.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{HARNESS}}/adapters/codex/hooks/check-after-edit.py",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{HARNESS}}/adapters/codex/hooks/check-after-shell.py",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
