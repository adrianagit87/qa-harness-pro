{
  "qa-harness-pro": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{HARNESS}}/adapters/antigravity/hooks/block-destructive-command.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{HARNESS}}/adapters/antigravity/hooks/validate-external-write.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 {{HARNESS}}/adapters/antigravity/hooks/surface-pending-check.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{HARNESS}}/adapters/antigravity/hooks/check-after-edit.py",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
